---
import Icon from './Icon.astro';
import { categoryPath, type Category } from '../data/categories.ts';
import { href } from '../lib/url.ts';

interface Props {
  category: Category;
  count?: number;
  headingLevel?: 'h2' | 'h3';
}

const { category, count, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="cat-card">
  <span class="cat-card__icon"><Icon name={category.icon as 'bank'} size={22} /></span>
  <div>
    <Heading class="cat-card__title"><a href={href(categoryPath(category.key))}>{category.label}</a></Heading>
    <p class="cat-card__tagline">{category.tagline}</p>
    {count !== undefined && count > 0 && <p class="cat-card__count">{count} épisode{count > 1 ? 's' : ''}</p>}
  </div>
</article>

<style>
  .cat-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.25s var(--ease-out);
  }

  .cat-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .cat-card__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--paper);
    color: var(--slate);
  }

  .cat-card__title {
    font-size: 1.05rem;
  }

  .cat-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .cat-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cat-card:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .cat-card__title a:focus-visible {
    outline: none;
  }

  .cat-card__tagline {
    margin-top: 0.2rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .cat-card__count {
    margin-top: 0.35rem;
    color: var(--orange-ink);
    font-size: var(--text-xs);
    font-weight: 700;
  }
</style>
