---
// Fiche du lexique sous forme de note papier scotchée.
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/url.ts';

interface Props {
  term: CollectionEntry<'lexique'>;
  tilt?: 'l' | 'r' | undefined;
  headingLevel?: 'h2' | 'h3';
}

const { term, tilt, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class:list={['term-note', 'note', tilt && `note--tilt-${tilt}`]}>
  <Heading class="term-note__term"><a href={href(`/lexique/${term.id}/`)}>{term.data.term}</a></Heading>
  {term.data.expansion && <p class="term-note__expansion">{term.data.expansion}</p>}
  <p class="term-note__definition">{term.data.definition}</p>
</article>

<style>
  .term-note {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s;
  }

  .term-note:hover {
    transform: rotate(0) translateY(-3px);
  }

  .term-note__term {
    font-family: var(--font-hand);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .term-note__term a {
    color: var(--slate);
    text-decoration: none;
  }

  .term-note__term a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .term-note:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .term-note__term a:focus-visible {
    outline: none;
  }

  .term-note__expansion {
    color: var(--orange-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .term-note__definition {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
</style>
