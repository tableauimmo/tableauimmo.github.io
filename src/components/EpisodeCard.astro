---
import EpisodeThumb from './EpisodeThumb.astro';
import Icon from './Icon.astro';
import { CATEGORIES } from '../data/categories.ts';
import { episodeLabel } from '../lib/episode-label.ts';
import { episodePath, type PublishedEpisode } from '../lib/episodes.ts';
import { formatDate, isoDay } from '../lib/format.ts';
import { href } from '../lib/url.ts';
import { formatDurationShort } from '../lib/youtube.ts';

interface Props {
  episode: PublishedEpisode;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { episode, headingLevel = 'h3', eager = false } = Astro.props;
const { data } = episode;
const Heading = headingLevel;
---

<article class="ep-card">
  <div class="ep-card__media">
    <EpisodeThumb episode={episode} eager={eager} />
    {data.duration && <span class="ep-card__duration"><Icon name="play" size={12} /> {formatDurationShort(data.duration)}</span>}
  </div>
  <div class="ep-card__body">
    <p class="ep-card__meta">
      <span class="ep-card__number">{episodeLabel(data)}</span>
      <span aria-hidden="true">·</span>
      <span>{CATEGORIES[data.category].label}</span>
    </p>
    <Heading class="ep-card__title">
      <a href={href(episodePath(episode))} class="ep-card__link">{data.title}</a>
    </Heading>
    <p class="ep-card__teaser">{data.teaser}</p>
    <p class="ep-card__date">
      Publié le <time datetime={isoDay(data.publishedAt)}>{formatDate(data.publishedAt)}</time>
    </p>
  </div>
</article>

<style>
  .ep-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.25s, transform 0.25s var(--ease-out), border-color 0.25s;
  }

  .ep-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--line-strong);
  }

  .ep-card__media {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .ep-card__duration {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    background: rgb(20 26 24 / 0.85);
    color: var(--chalk);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ep-card__body {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.3rem;
  }

  .ep-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--ink-mute);
    font-size: var(--text-xs);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ep-card__number {
    color: var(--orange-ink);
  }

  .ep-card__title {
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .ep-card__link {
    color: var(--ink);
    text-decoration: none;
  }

  .ep-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ep-card__link:focus-visible {
    outline: none;
  }

  .ep-card:has(.ep-card__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .ep-card__teaser {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .ep-card__date {
    margin-top: 0.25rem;
    color: var(--ink-mute);
    font-size: var(--text-xs);
  }
</style>
