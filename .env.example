# Copier en .env (jamais versionné) pour les commandes locales.

# Facultatif : clé API YouTube Data v3 (durée exacte des vidéos lors de la synchronisation).
YOUTUBE_API_KEY=

# Facultatif : URL publique du site (défaut : site.config.mjs).
SITE_URL=

# Routine de visibilité (voir visibilite/README.md) — facultatif.
# Clé Google Cloud : PageSpeed Insights, YouTube Data v3 et Knowledge Graph Search.
GOOGLE_API_KEY=
# Compte de service Search Console (défaut : .secrets/search-console.json).
GSC_CREDENTIALS_FILE=
