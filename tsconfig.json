{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "dist-fixture", ".e2e", "node_modules", "test-results", "playwright-report", "studio", ".screens"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
