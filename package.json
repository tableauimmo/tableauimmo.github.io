{
  "name": "tableau-immo-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site de Tableau Immo — l'investissement immobilier en France expliqué au tableau : épisodes, calculateurs, lexique.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:fixture && playwright test",
    "verify": "npm run check && npm run test && npm run test:e2e",
    "build:fixture": "node scripts/build-fixture.ts",
    "sync:youtube": "node scripts/youtube-sync.ts",
    "episode:add": "node scripts/episode-add.ts",
    "assets:og": "python3 scripts/assets/build_og.py",
    "screens": "node scripts/screens.ts",
    "visibilite": "node --env-file-if-exists=.env scripts/visibility/collect.ts",
    "visibilite:soumettre": "node --env-file-if-exists=.env scripts/visibility/submit.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^6.0.3",
    "ultrahtml": "^1.7.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
